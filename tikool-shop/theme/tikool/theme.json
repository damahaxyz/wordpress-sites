    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
          "name": "Tikool Sans",
          "slug": "tikool-sans"
        },
        {
          "fontFamily": "Fraunces, \"Iowan Old Style\", Georgia, serif",
          "name": "Tikool Serif",
          "slug": "tikool-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#fbf5ed",
      "text": "#2c211e"
    },
    "typography": {
      "fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
      "lineHeight": "1.65"
    }
  }
}
