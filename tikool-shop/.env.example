COMPOSE_PROJECT_NAME=tikool-shop

# 默认只接受本机反向代理流量，避免绕过 HTTPS。
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8085

# 正式部署前必须将两个 CHANGE_ME 替换为不同的高强度随机密码。
MARIADB_DATABASE=wordpress_tikool
MARIADB_USER=wordpress_tikool
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# 仅绑定宿主机 127.0.0.1，供 DBeaver SSH Tunnel 使用。
MARIADB_HOST_PORT=3311

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_HOME=https://www.tikool.com
WORDPRESS_SITEURL=https://www.tikool.com
WORDPRESS_REDIS_DATABASE=0
REDIS_MAXMEMORY=256mb

# 服务器上独立 clone 的 NFC 页面仓库；本地开发默认使用 runtime 目录。
MEMORY_PAGES_REPO_PATH=./runtime/memory-pages-repo

# 固定主要版本，升级前请先备份并查看映像版本说明。
WORDPRESS_IMAGE=wordpress:7.0-php8.3-fpm
WPCLI_IMAGE=wordpress:cli-php8.3
MARIADB_IMAGE=mariadb:11.8
NGINX_IMAGE=nginx:1.28-alpine
REDIS_IMAGE=redis:7.4-alpine
