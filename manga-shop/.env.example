COMPOSE_PROJECT_NAME=manga-shop

# Local-only listeners. Keep public traffic behind the host Nginx proxy.
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8084

# Replace both CHANGE_ME values with different strong passwords before startup.
MARIADB_DATABASE=wordpress_manga
MARIADB_USER=wordpress_manga
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_HOST_PORT=3310

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_HOME=https://www.mangaproduct.com
WORDPRESS_SITEURL=https://www.mangaproduct.com
WORDPRESS_REDIS_DATABASE=0
REDIS_MAXMEMORY=256mb

# Pin major versions; back up before changing them.
WORDPRESS_IMAGE=wordpress:7.0-php8.3-fpm
WPCLI_IMAGE=wordpress:cli-php8.3
MARIADB_IMAGE=mariadb:11.8
NGINX_IMAGE=nginx:1.28-alpine
REDIS_IMAGE=redis:7.4-alpine
