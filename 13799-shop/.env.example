COMPOSE_PROJECT_NAME=wordpress

# 對外監聽設定；若前方另有反向代理，可改成 127.0.0.1。
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=8080

# 請使用不同的高強度密碼，不要保留範例值。
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=my_perfume_maridb_password_112233
MARIADB_ROOT_PASSWORD=my_perfume_maridb_root_password_112233
# 僅綁定伺服器的 127.0.0.1，供 DBeaver SSH Tunnel 使用。
MARIADB_HOST_PORT=3306

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_REDIS_DATABASE=0
REDIS_MAXMEMORY=256mb

# 固定主要版本，升級前請先備份並查看映像版本說明。
WORDPRESS_IMAGE=wordpress:7.0-php8.3-fpm
MARIADB_IMAGE=mariadb:11.8
NGINX_IMAGE=nginx:1.28-alpine
REDIS_IMAGE=redis:7.4-alpine
