{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "color": "#111111",
          "name": "Carbon",
          "slug": "carbon"
        },
        {
          "color": "#3f3f46",
          "name": "Graphite",
          "slug": "graphite"
        },
        {
          "color": "#fafafa",
          "name": "Paper",
          "slug": "paper"
        },
        {
          "color": "#ffffff",
          "name": "White",
          "slug": "white"
        },
        {
          "color": "#b18a4b",
          "name": "Muted Gold",
          "slug": "muted-gold"
        }
      ]
    },
    "layout": {
      "contentSize": "820px",
      "wideSize": "1240px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", Arial, sans-serif",
          "name": "Inter",
          "slug": "inter"
        },
        {
          "fontFamily": "\"Montserrat\", Arial, sans-serif",
          "name": "Montserrat",
          "slug": "montserrat"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#fafafa",
      "text": "#111111"
    },
    "typography": {
      "fontFamily": "\"Inter\", Arial, sans-serif",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "\"Montserrat\", Arial, sans-serif"
        }
      }
    }
  }
}
